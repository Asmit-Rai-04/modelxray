FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=0 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

RUN groupadd --system --gid 10001 modelxray \
    && useradd --system --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin modelxray

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
COPY apps/api/modelxray /app/modelxray

RUN python -m pip install --upgrade pip \
    && pip install fastapi "uvicorn[standard]" pydantic numpy pandas scikit-learn scipy statsmodels joblib python-multipart httpx

RUN mkdir -p /app/data/assets /app/data \
    && chown -R modelxray:modelxray /app

USER modelxray
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()"

CMD ["uvicorn", "modelxray.main:app", "--host", "0.0.0.0", "--port", "8000"]
